# Copy this file to .env only if .env does not already exist.
# Replace the placeholder password locally; never commit .env.
POSTGRES_DB=employee_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Compose requires an explicit profile. "local" is unauthenticated demo mode.
SPRING_PROFILES_ACTIVE=local
SECURITY_OAUTH2_ISSUER_URI=

POSTGRES_PORT=5432
ML_SERVICE_PORT=8000
BACKEND_PORT=8080
BACKEND_MANAGEMENT_PORT=8081
MCP_SERVER_PORT=8001
KAFKA_PORT=9092

# MCP is opt-in (`docker compose --profile mcp up`). The role is a capability
# filter, not an authenticated user identity. Keep the loopback binding.
MCP_ROLE=employee
# For secure Spring mode, provide a valid bearer token via a private .env or
# deployment secret. Never commit a real token.
SPRING_API_BEARER_TOKEN=

# Kafka is opt-in. Enable publishing only when the messaging profile is running.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_KAFKA_TOPIC=employee-intelligence.events

# With host-installed Ollama, leave this as the default. For the Compose "ai"
# profile set it to http://ollama:11434. Model downloads are always manual.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

EMPLOYEE_IMPORT_ENABLED=false
EMPLOYEE_IMPORT_FILE=

# --------------------------------------------------------------------------
# Optional dashboard cache (Redis)
# --------------------------------------------------------------------------
# Not part of the default Compose stack.
CACHE_REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------------
# Optional notification consumer
# --------------------------------------------------------------------------
NOTIFICATIONS_CONSUMER_ENABLED=false
NOTIFICATIONS_CONSUMER_GROUP=notifications-v1

# --------------------------------------------------------------------------
# CORS
# --------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
